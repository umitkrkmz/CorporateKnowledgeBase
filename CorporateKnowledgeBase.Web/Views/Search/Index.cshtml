@model CorporateKnowledgeBase.Application.Features.Search.SearchResultDto

<div class="kb-page-header">
    <div>
        <h1 style="display: flex; align-items: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Search
        </h1>
        <p style="color: var(--text-muted); margin: 0;">Find documents and blog posts across the knowledge base.</p>
    </div>
</div>

<div class="kb-panel" style="margin-bottom: 1.5rem;">
    <form asp-action="Index" method="get">
        <div style="display: flex; gap: 0.5rem;">
            <div style="flex: 1; position: relative;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0.875rem; top: 50%; transform: translateY(-50%); pointer-events: none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input name="q" class="kb-form-control" placeholder="Search documents or blog posts..."
                       value="@ViewBag.SearchTerm" style="padding-left: 2.75rem;" />
            </div>
            <button type="submit" class="kb-btn kb-btn-primary">Search</button>
        </div>
    </form>
</div>

@if (ViewBag.SearchTerm != null)
{
    var totalCount = Model.Documents.Count + Model.BlogPosts.Count;
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
        Found <strong style="color: var(--text-dark);">@totalCount</strong> results for <strong style="color: var(--text-dark);">"@ViewBag.SearchTerm"</strong>
    </p>

    @if (Model.Documents.Any())
    {
        <div style="margin-bottom: 2rem;">
            <h4 style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-dark); margin-bottom: 1rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                Documents
                <span class="kb-badge kb-badge-muted">@Model.Documents.Count</span>
            </h4>
            @foreach (var doc in Model.Documents)
            {
                <div class="kb-card" style="margin-bottom: 0.75rem;">
                    <div class="kb-card-body" style="padding: 1rem 1.25rem;">
                        <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id"
                           style="font-weight: 600; color: var(--brand-primary); text-decoration: none; font-size: 1.05rem;">@doc.Title</a>
                        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0.35rem 0 0.5rem;">@doc.Snippet</p>
                        <div style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-muted); font-size: 0.8rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                            @doc.CreatedAt.ToString("dd.MM.yyyy")
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.BlogPosts.Any())
    {
        <div style="margin-bottom: 2rem;">
            <h4 style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-dark); margin-bottom: 1rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                Blog Posts
                <span class="kb-badge kb-badge-muted">@Model.BlogPosts.Count</span>
            </h4>
            @foreach (var post in Model.BlogPosts)
            {
                <div class="kb-card" style="margin-bottom: 0.75rem;">
                    <div class="kb-card-body" style="padding: 1rem 1.25rem;">
                        <a asp-controller="BlogPosts" asp-action="Details" asp-route-id="@post.Id"
                           style="font-weight: 600; color: var(--brand-primary); text-decoration: none; font-size: 1.05rem;">@post.Title</a>
                        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0.35rem 0 0.5rem;">@post.Snippet</p>
                        <div style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-muted); font-size: 0.8rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                            @post.CreatedAt.ToString("dd.MM.yyyy")
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!Model.Documents.Any() && !Model.BlogPosts.Any())
    {
        <div class="kb-empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.4;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <p style="color: var(--text-muted); margin-top: 1rem;">No results found for "<strong>@ViewBag.SearchTerm</strong>".</p>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Try adjusting your search terms or using different keywords.</p>
        </div>
    }
}
