<div class="kb-page-header">
    <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--text-dark);">New Category</h2>
</div>

<div class="kb-form-card">
    <form asp-action="Create" method="post">
        <div class="kb-form-group">
            <label class="kb-form-label">Name</label>
            <input name="name" class="kb-form-control" required />
        </div>
        <div class="kb-form-group">
            <label class="kb-form-label">Description</label>
            <textarea name="description" class="kb-form-control" rows="3"></textarea>
            <span class="kb-form-hint">Optional. A brief description of this category.</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem; padding-top: 0.5rem;">
            <button type="submit" class="kb-btn kb-btn-primary">Save</button>
            <a asp-action="Index" class="kb-btn kb-btn-outline">Cancel</a>
        </div>
    </form>
</div>
