@model CorporateKnowledgeBase.Application.Features.Profile.UserProfileDto

<div class="kb-notification-page">
    <a asp-action="Index" class="kb-back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Profile
    </a>

    <div class="kb-notification-header">
        <div class="kb-notification-header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        </div>
        <h1>Notification Settings</h1>
        <p>Choose which notifications you want to receive</p>
    </div>

    <form asp-action="NotificationSettings" method="post">
        <div class="kb-notification-card">
            <!-- Comment Notifications -->
            <label class="kb-notification-item">
                <div class="kb-notification-info">
                    <div class="kb-notification-icon comments">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <div class="kb-notification-text">
                        <h4>New comments</h4>
                        <p>Get notified when someone comments on content</p>
                    </div>
                </div>
                <div class="kb-toggle">
                    <input type="checkbox" name="notifyOnNewComment" value="true" @(Model.NotifyOnNewComment ? "checked" : "") />
                    <span class="kb-toggle-slider"></span>
                </div>
            </label>

            <!-- Blog Post Notifications -->
            <label class="kb-notification-item">
                <div class="kb-notification-info">
                    <div class="kb-notification-icon blogs">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </div>
                    <div class="kb-notification-text">
                        <h4>New blog posts</h4>
                        <p>Get notified when a new blog post is published</p>
                    </div>
                </div>
                <div class="kb-toggle">
                    <input type="checkbox" name="notifyOnNewBlogPost" value="true" @(Model.NotifyOnNewBlogPost ? "checked" : "") />
                    <span class="kb-toggle-slider"></span>
                </div>
            </label>

            <!-- Document Notifications -->
            <label class="kb-notification-item">
                <div class="kb-notification-info">
                    <div class="kb-notification-icon documents">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    <div class="kb-notification-text">
                        <h4>New documents</h4>
                        <p>Get notified when a new document is uploaded</p>
                    </div>
                </div>
                <div class="kb-toggle">
                    <input type="checkbox" name="notifyOnNewDocument" value="true" @(Model.NotifyOnNewDocument ? "checked" : "") />
                    <span class="kb-toggle-slider"></span>
                </div>
            </label>

            <!-- Announcement Notifications -->
            <label class="kb-notification-item">
                <div class="kb-notification-info">
                    <div class="kb-notification-icon announcements">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 13v-2z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
                    </div>
                    <div class="kb-notification-text">
                        <h4>New announcements</h4>
                        <p>Get notified when a new announcement is posted</p>
                    </div>
                </div>
                <div class="kb-toggle">
                    <input type="checkbox" name="notifyOnNewAnnouncement" value="true" @(Model.NotifyOnNewAnnouncement ? "checked" : "") />
                    <span class="kb-toggle-slider"></span>
                </div>
            </label>
        </div>

        <div class="kb-notification-actions">
            <button type="submit" class="kb-btn kb-btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Save Settings
            </button>
            <a asp-action="Index" class="kb-btn kb-btn-outline" style="padding: 0.75rem 1.5rem;">Cancel</a>
        </div>
    </form>
</div>
