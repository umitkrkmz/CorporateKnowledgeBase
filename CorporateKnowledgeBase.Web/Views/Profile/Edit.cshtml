@model CorporateKnowledgeBase.Application.Features.Profile.UserProfileDto

<div class="kb-edit-profile-page">
    <div class="kb-page-header">
        <div>
            <h1 style="display: flex; align-items: center; gap: 0.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                Edit Profile
            </h1>
            <p style="color: var(--text-muted); margin: 0;">Update your personal information and profile photo.</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="kb-alert kb-alert-danger" style="margin-bottom: 1.5rem;">@TempData["Error"]</div>
    }

    <div class="kb-edit-profile-grid">
        <!-- Left Column: Profile Photo -->
        <div class="kb-edit-card">
            <h3 class="kb-edit-card-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                Profile Photo
            </h3>
            <div class="kb-avatar-upload-section">
                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                {
                    <img src="@Model.ProfileImagePath" alt="@Model.FullName" class="kb-avatar-preview" />
                }
                else
                {
                    <div class="kb-avatar-placeholder">
                        @Model.FullName[0]
                    </div>
                }
                <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="kb-upload-form">
                    <div class="kb-file-input-wrapper">
                        <input type="file" name="photo" class="kb-form-control" accept="image/*" style="flex: 1;" />
                        <button type="submit" class="kb-btn kb-btn-outline" style="display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
                            Upload
                        </button>
                    </div>
                    <p class="kb-form-hint" style="text-align: center;">Max 5 MB. JPG, PNG, GIF, WebP</p>
                </form>
            </div>
        </div>

        <!-- Right Column: Personal Information -->
        <div class="kb-edit-card">
            <h3 class="kb-edit-card-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Personal Information
            </h3>
            <form asp-action="Edit" method="post">
                <div class="kb-form-grid">
                    <div class="kb-form-group full-width">
                        <label class="kb-form-label">Full Name</label>
                        <input name="fullName" class="kb-form-control" value="@Model.FullName" required />
                    </div>
                    <div class="kb-form-group">
                        <label class="kb-form-label">Department</label>
                        <select name="departmentId" class="kb-form-control" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Departments)">
                        </select>
                    </div>
                    <div class="kb-form-group">
                        <label class="kb-form-label">Job Title</label>
                        <input name="jobTitle" class="kb-form-control" value="@Model.JobTitle" placeholder="e.g. Software Engineer" />
                    </div>
                    <div class="kb-form-group full-width">
                        <label class="kb-form-label">Email</label>
                        <input class="kb-form-control" value="@Model.Email" disabled style="background: var(--bg-surface); color: var(--text-muted);" />
                        <p class="kb-form-hint">Email address cannot be changed.</p>
                    </div>
                </div>
                <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                    <button type="submit" class="kb-btn kb-btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Save
                    </button>
                    <a asp-action="Index" class="kb-btn kb-btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
