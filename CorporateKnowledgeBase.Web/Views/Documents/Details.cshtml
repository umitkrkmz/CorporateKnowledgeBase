@model CorporateKnowledgeBase.Application.Features.Documents.DocumentDetailDto
@using CorporateKnowledgeBase.Application.Features.Comments
@{
    var comments = (List<CommentDto>)ViewBag.Comments;
    int likeCount = ViewBag.LikeCount;
    bool isLiked = ViewBag.IsLiked;

    int CountAll(List<CommentDto> list)
    {
        int count = 0;
        foreach (var c in list) { count += 1 + CountAll(c.Replies); }
        return count;
    }
}

@functions {
    void RenderComment(CommentDto c, int depth, int documentId)
    {
        var marginLeft = depth * 40;
        <div class="kb-comment" style="margin-left: @(marginLeft)px;" id="comment-@c.Id">
            <div class="kb-comment-avatar">
                @if (!string.IsNullOrEmpty(c.AuthorImagePath))
                {
                    <img src="@c.AuthorImagePath" alt="@c.AuthorName" />
                }
                else
                {
                    @c.AuthorName[0]
                }
            </div>
            <div style="flex: 1;">
                <div class="kb-comment-body">
                    <div class="kb-comment-meta">
                        <span class="kb-comment-author">@c.AuthorName</span>
                        <span class="kb-comment-time">@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <div class="kb-comment-content">@c.Content</div>
                </div>
                @if (User.Identity!.IsAuthenticated)
                {
                    <button class="kb-btn kb-btn-sm" style="background: none; border: none; color: var(--text-muted); padding: 0.25rem 0; margin-top: 0.25rem; font-size: 0.78rem;"
                            onclick="showReplyBox(@c.Id)">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                        Reply
                    </button>
                }
                <div id="reply-box-@c.Id" class="d-none" style="margin-top: 0.5rem;">
                    <div style="display: flex; gap: 0.5rem;">
                        <input id="reply-input-@c.Id" class="kb-form-control" style="flex: 1;" placeholder="Write a reply..." />
                        <button class="kb-btn kb-btn-primary kb-btn-sm"
                                onclick="postComment(@c.Id, @documentId, null)">Send</button>
                        <button class="kb-btn kb-btn-outline kb-btn-sm"
                                onclick="document.getElementById('reply-box-@c.Id').classList.add('d-none')">Cancel</button>
                    </div>
                </div>
                @foreach (var reply in c.Replies)
                {
                    RenderComment(reply, depth + 1, documentId);
                }
            </div>
        </div>
    }
}

<div class="row">
    <div class="col-lg-9">
        <!-- Detail Header -->
        <div class="kb-detail-header">
            <h1>@Model.Title</h1>
            <div class="kb-detail-meta">
                <span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    @Model.ViewCount views
                </span>
                <span style="color: var(--border-color);">|</span>
                <span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </span>
            </div>
            <div class="kb-detail-badges">
                <span class="kb-badge kb-badge-primary">@Model.CategoryName</span>
                @{
                    var statusBadge = Model.Status switch
                    {
                        CorporateKnowledgeBase.Domain.Enums.ContentStatus.Draft => "kb-badge-muted",
                        CorporateKnowledgeBase.Domain.Enums.ContentStatus.PendingReview => "kb-badge-warning",
                        CorporateKnowledgeBase.Domain.Enums.ContentStatus.Published => "kb-badge-success",
                        CorporateKnowledgeBase.Domain.Enums.ContentStatus.Rejected => "kb-badge-danger",
                        _ => "kb-badge-muted"
                    };
                }
                <span class="kb-badge @statusBadge">@Model.Status</span>
                @foreach (var tag in Model.Tags)
                {
                    <a href="@Url.Action("Index", "Documents", new { tag })"
                       class="kb-badge kb-badge-tag">#@tag</a>
                }
            </div>
        </div>

        @if (Model.Status == CorporateKnowledgeBase.Domain.Enums.ContentStatus.Rejected && !string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="kb-alert kb-alert-danger">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span><strong>Rejected:</strong> @Model.RejectionReason</span>
            </div>
        }

        <!-- Like button -->
        <button id="likeBtn" class="kb-like-btn @(isLiked ? "liked" : "")" onclick="toggleLike()" style="margin-bottom: 1.25rem;">
            <svg id="likeIcon" width="16" height="16" viewBox="0 0 24 24" fill="@(isLiked ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span id="likeCount">@likeCount</span>
        </button>

        <!-- Content -->
        <div class="kb-panel">
            <div class="content-body">@Html.Raw(ViewBag.ResolvedContent ?? Model.Content)</div>
        </div>

        <!-- Action buttons -->
        <div class="kb-detail-actions">
            @{
                bool canEdit = ViewBag.CanEdit ?? false;
                bool canDelete = ViewBag.CanDelete ?? false;
                bool isApproved = ViewBag.IsApproved ?? false;
            }
            @if (canEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="kb-btn kb-btn-warning kb-btn-sm">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Edit
                </a>
            }
            <a asp-action="Versions" asp-route-id="@Model.Id" class="kb-btn kb-btn-info kb-btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Version History
            </a>
            <a asp-action="ExportPdf" asp-route-id="@Model.Id" class="kb-btn kb-btn-outline kb-btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export PDF
            </a>
            @if (canDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this document? This action cannot be undone.');">
                    <button type="submit" class="kb-btn kb-btn-danger kb-btn-sm">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        Delete
                    </button>
                </form>
            }
            @if (Model.Status == CorporateKnowledgeBase.Domain.Enums.ContentStatus.Draft && canEdit)
            {
                <form asp-action="SubmitForReview" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="kb-btn kb-btn-info kb-btn-sm">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Submit for Review
                    </button>
                </form>
            }
            @if (Model.Status == CorporateKnowledgeBase.Domain.Enums.ContentStatus.PendingReview && (User.IsInRole("Admin") || User.IsInRole("Editor")))
            {
                <form asp-controller="ContentReview" asp-action="Approve" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="contentType" value="0" />
                    <button type="submit" class="kb-btn kb-btn-success kb-btn-sm">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Approve
                    </button>
                </form>
                <button class="kb-btn kb-btn-danger kb-btn-sm" data-bs-toggle="modal" data-bs-target="#rejectContentModal">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    Reject
                </button>
            }
            @if (User.Identity!.IsAuthenticated)
            {
                <button class="kb-btn kb-btn-outline kb-btn-sm" data-bs-toggle="modal" data-bs-target="#reportModal">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                    Report
                </button>
            }
            <a asp-action="Index" class="kb-btn kb-btn-outline kb-btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back
            </a>
        </div>

        <!-- Reject Content Modal -->
        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
        {
            <div class="modal fade" id="rejectContentModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-controller="ContentReview" asp-action="Reject" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="contentType" value="0" />
                            <div class="modal-header">
                                <h5 class="modal-title">Reject Content</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="kb-form-group">
                                    <label class="kb-form-label">Reason for rejection</label>
                                    <textarea name="reason" class="kb-form-control" rows="3" required
                                              placeholder="Explain why this content is being rejected..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="kb-btn kb-btn-outline" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="kb-btn kb-btn-danger">Reject</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        <!-- Report Modal -->
        @if (User.Identity!.IsAuthenticated)
        {
            <div class="modal fade" id="reportModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Report Content</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="kb-form-group">
                                <label class="kb-form-label">Reason</label>
                                <select id="reportReason" class="kb-form-control">
                                    <option value="">Select a reason...</option>
                                    <option value="Spam/Advertising">Spam / Advertising</option>
                                    <option value="Offensive Language">Offensive Language</option>
                                    <option value="Misinformation">Misinformation</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="kb-form-group">
                                <label class="kb-form-label">Description (optional)</label>
                                <textarea id="reportDescription" class="kb-form-control" rows="3" placeholder="Provide more details..."></textarea>
                            </div>
                            <div id="reportMessage" class="d-none"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="kb-btn kb-btn-outline" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="kb-btn kb-btn-warning" onclick="submitReport()">Submit Report</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Comments section -->
        <div class="kb-panel" style="margin-top: 1.5rem;">
            <div class="kb-panel-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Comments (@CountAll(comments))
            </div>

            @if (isApproved)
            {
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem;">
                    <input id="commentInput" class="kb-form-control" placeholder="Write a comment..." style="flex: 1;" />
                    <button class="kb-btn kb-btn-primary" onclick="postComment(null, @Model.Id, null)">Send</button>
                </div>
            }

            <div id="commentsList">
                @foreach (var c in comments)
                {
                    RenderComment(c, 0, Model.Id);
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function toggleLike() {
        try {
            const res = await fetch('/api/Likes/toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contentId: @Model.Id, contentType: 'Document' })
            });
            const data = await res.json();
            document.getElementById('likeCount').textContent = data.count;
            const btn = document.getElementById('likeBtn');
            const icon = document.getElementById('likeIcon');
            if (data.isLiked) {
                btn.className = 'kb-like-btn liked';
                icon.setAttribute('fill', 'currentColor');
            } else {
                btn.className = 'kb-like-btn';
                icon.setAttribute('fill', 'none');
            }
        } catch (e) { alert('Please log in to like.'); }
    }

    function showReplyBox(commentId) {
        const box = document.getElementById('reply-box-' + commentId);
        box.classList.remove('d-none');
        document.getElementById('reply-input-' + commentId).focus();
    }

    async function postComment(parentId, documentId, blogPostId) {
        let content;
        if (parentId) {
            const input = document.getElementById('reply-input-' + parentId);
            content = input.value.trim();
            if (!content) return;
        } else {
            const input = document.getElementById('commentInput');
            content = input.value.trim();
            if (!content) return;
        }

        let body = 'content=' + encodeURIComponent(content);
        if (documentId) body += '&documentId=' + documentId;
        if (blogPostId) body += '&blogPostId=' + blogPostId;
        if (parentId) body += '&parentCommentId=' + parentId;

        const res = await fetch('@Url.Action("Create", "Comments")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        });
        const data = await res.json();

        // Build comment HTML
        const avatarHtml = data.authorImagePath
            ? `<img src="${data.authorImagePath}" alt="${data.authorName}" />`
            : `${data.authorName[0]}`;

        const commentHtml = `
            <div class="kb-comment" id="comment-${data.id}">
                <div class="kb-comment-avatar">${avatarHtml}</div>
                <div style="flex:1;">
                    <div class="kb-comment-body">
                        <div class="kb-comment-meta">
                            <span class="kb-comment-author">${data.authorName}</span>
                            <span class="kb-comment-time">${data.createdAt}</span>
                        </div>
                        <div class="kb-comment-content">${data.content}</div>
                    </div>
                </div>
            </div>`;

        if (parentId) {
            // Insert reply after parent comment's reply box
            const replyBox = document.getElementById('reply-box-' + parentId);
            replyBox.insertAdjacentHTML('afterend', commentHtml);
            replyBox.classList.add('d-none');
            document.getElementById('reply-input-' + parentId).value = '';
        } else {
            document.getElementById('commentsList').insertAdjacentHTML('afterbegin', commentHtml);
            document.getElementById('commentInput').value = '';
        }
    }

    async function submitReport() {
        const reason = document.getElementById('reportReason').value;
        const description = document.getElementById('reportDescription').value;
        const msgDiv = document.getElementById('reportMessage');

        if (!reason) {
            msgDiv.className = 'kb-alert kb-alert-danger';
            msgDiv.textContent = 'Please select a reason.';
            return;
        }
        if (reason === 'Other' && !description.trim()) {
            msgDiv.className = 'kb-alert kb-alert-danger';
            msgDiv.textContent = "Please provide a description for 'Other'.";
            return;
        }

        try {
            const res = await fetch('/api/ReportsApi/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contentId: @Model.Id, contentType: 0, reason: reason, description: description })
            });
            const data = await res.json();
            if (data.success) {
                msgDiv.className = 'kb-alert kb-alert-success';
                msgDiv.textContent = data.message;
                setTimeout(() => bootstrap.Modal.getInstance(document.getElementById('reportModal')).hide(), 2000);
            } else {
                msgDiv.className = 'kb-alert kb-alert-danger';
                msgDiv.textContent = data.message;
            }
        } catch (e) {
            msgDiv.className = 'kb-alert kb-alert-danger';
            msgDiv.textContent = 'An error occurred. Please try again.';
        }
    }
</script>
}
