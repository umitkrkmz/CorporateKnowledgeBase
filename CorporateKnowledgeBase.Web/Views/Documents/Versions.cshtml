@model List<CorporateKnowledgeBase.Application.Features.Documents.DocumentVersionDto>

<div class="kb-admin-page">
    <div class="kb-page-header">
        <div>
            <h2>Version History</h2>
            <p style="color: var(--text-muted); margin: 0;">View and restore previous versions of this document.</p>
        </div>
        <a asp-action="Details" asp-route-id="@ViewBag.DocumentId" class="kb-btn kb-btn-outline kb-btn-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Back to Document
        </a>
    </div>

    @if (TempData["Success"] is string msg)
    {
        <div class="kb-alert kb-alert-success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>@msg</span>
        </div>
    }

    @if (Model.Any())
    {
        <div class="kb-panel" style="padding: 1rem; margin-bottom: 1.5rem; background: var(--bg-surface);">
            <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span style="font-weight: 600; color: var(--text-dark);">@Model.Count versions</span>
                </div>
                <div style="color: var(--text-muted); font-size: 0.875rem;">
                    Latest: @Model.First().CreatedAt.ToString("dd MMM yyyy, HH:mm")
                </div>
                @if (Model.Count > 1)
                {
                    <div style="color: var(--text-muted); font-size: 0.875rem;">
                        Oldest: @Model.Last().CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </div>
                }
            </div>
        </div>

        <div class="kb-version-timeline">
            @{
                var versionNum = Model.Count;
                var isFirst = true;
            }
            @foreach (var v in Model)
            {
                var collapseId = $"collapse{v.Id}";
                <div class="kb-version-item @(isFirst ? "kb-version-current" : "")">
                    <div class="kb-version-marker">
                        <div class="kb-version-dot"></div>
                        @if (versionNum > 1)
                        {
                            <div class="kb-version-line"></div>
                        }
                    </div>
                    <div class="kb-version-card">
                        <div class="kb-version-header" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor: pointer;">
                            <div class="kb-version-info">
                                <span class="kb-version-badge @(isFirst ? "kb-badge-current" : "")">
                                    v@(versionNum)
                                    @if (isFirst)
                                    {
                                        <span class="kb-version-tag">Current</span>
                                    }
                                </span>
                                <span class="kb-version-title">@v.Title</span>
                            </div>
                            <div class="kb-version-meta">
                                <span class="kb-version-author">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    @v.ModifiedBy
                                </span>
                                <span class="kb-version-date">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    @v.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </span>
                                <svg class="kb-version-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </div>
                        </div>
                        <div id="@collapseId" class="collapse">
                            <div class="kb-version-content">
                                <div class="kb-version-content-header">
                                    <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Content Preview (Markdown)</span>
                                    <button type="button" class="kb-btn kb-btn-outline kb-btn-sm" onclick="copyVersionContent('@v.Id')">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                        Copy
                                    </button>
                                </div>
                                <pre id="content-@v.Id" class="kb-version-pre">@v.Content</pre>
                                @if (User.Identity!.IsAuthenticated && !isFirst)
                                {
                                    <form asp-action="RestoreVersion" method="post" class="kb-version-actions"
                                          onsubmit="return confirm('Are you sure you want to restore this version? The current document will be backed up automatically.');">
                                        <input type="hidden" name="versionId" value="@v.Id" />
                                        <button type="submit" class="kb-btn kb-btn-warning kb-btn-sm">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                                            Restore This Version
                                        </button>
                                        <span style="font-size: 0.8rem; color: var(--text-muted);">Current version will be automatically backed up</span>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                versionNum--;
                isFirst = false;
            }
        </div>
    }
    else
    {
        <div class="kb-empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <h4>No Version History</h4>
            <p>This document has no previous versions yet. Versions are created automatically when the document is edited.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function copyVersionContent(versionId) {
            var content = document.getElementById('content-' + versionId).textContent;
            navigator.clipboard.writeText(content).then(function() {
                alert('Content copied to clipboard!');
            });
        }
    </script>
}
