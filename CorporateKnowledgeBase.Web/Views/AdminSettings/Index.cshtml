@{
    ViewData["Title"] = "Admin Settings";
}

<div class="kb-page-header">
    <div>
        <h1>
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
            Admin Settings
        </h1>
        <p class="kb-page-subtitle">System configuration and data management</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="kb-alert kb-alert-success" style="margin-bottom: 1.5rem;">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
        @success
    </div>
}
@if (TempData["Warning"] is string warning)
{
    <div class="kb-alert kb-alert-warning" style="margin-bottom: 1.5rem;">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16M8 4a.905.905 0 0 1 .9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995A.905.905 0 0 1 8 4m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/></svg>
        @warning
    </div>
}

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 1.5rem;">

    <!-- Demo Data Seed -->
    <div class="kb-panel">
        <div style="padding: 1.75rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #10b981, #059669); display: flex; align-items: center; justify-content: center;">
                    <svg width="22" height="22" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 3v3m6.36-.64-2.12 2.12M21 12h-3M18.36 18.36l-2.12-2.12M12 21v-3M7.76 18.36l-2.12 2.12M3 12h3M5.64 5.64l2.12 2.12"/>
                    </svg>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #1a1a2e;">Load Demo Data</h3>
                    <p style="margin: 0; font-size: 0.8rem; color: #6b7280;">Generate synthetic test data</p>
                </div>
            </div>
            <p style="font-size: 0.85rem; color: #4b5563; line-height: 1.6; margin-bottom: 1.25rem;">
                Adds sample departments, users, categories, tags, documents, blog posts, announcements, comments and FAQ to the system.
                <br/><br/>
                <strong>Accounts to be created:</strong>
            </p>
            <div style="background: #f8fafc; border-radius: 8px; padding: 0.75rem; margin-bottom: 1.25rem; font-size: 0.78rem; font-family: 'SF Mono', 'Consolas', monospace;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem;">
                    <span style="color: #6b7280;">editor@@corp.com</span><span style="color: #059669;">Editor</span>
                    <span style="color: #6b7280;">member@@corp.com</span><span style="color: #059669;">Member</span>
                    <span style="color: #6b7280;">devops@@corp.com</span><span style="color: #059669;">Editor</span>
                    <span style="color: #6b7280;">qa@@corp.com</span><span style="color: #059669;">Member</span>
                    <span style="color: #6b7280;">pending@@corp.com</span><span style="color: #dc2626;">Pending</span>
                </div>
            </div>
            <form asp-action="SeedDemoData" method="post">
                <button type="submit" class="kb-btn kb-btn-success" style="width: 100%;"
                        onclick="return confirm('Load demo data? Existing data will be preserved.')">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    Load Demo Data
                </button>
            </form>
        </div>
    </div>

    <!-- Clear Demo Data -->
    <div class="kb-panel">
        <div style="padding: 1.75rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #ef4444, #dc2626); display: flex; align-items: center; justify-content: center;">
                    <svg width="22" height="22" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/>
                    </svg>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #1a1a2e;">Clear Demo Data</h3>
                    <p style="margin: 0; font-size: 0.8rem; color: #6b7280;">Delete all content and test users</p>
                </div>
            </div>
            <p style="font-size: 0.85rem; color: #4b5563; line-height: 1.6; margin-bottom: 1.25rem;">
                Deletes all documents, blog posts, announcements, comments, FAQ, tags, categories and demo users.
                <br/><br/>
                <strong style="color: #dc2626;">⚠️ This action cannot be undone!</strong><br/>
                Admin account and Engineering department will be preserved.
            </p>
            <form asp-action="ClearDemoData" method="post">
                <button type="submit" class="kb-btn kb-btn-danger" style="width: 100%;"
                        onclick="return confirm('⚠️ WARNING: All demo data will be deleted!\n\nAll data except admin account and Engineering department will be permanently deleted.\n\nDo you want to continue?')">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Clear Demo Data
                </button>
            </form>
        </div>
    </div>

</div>
