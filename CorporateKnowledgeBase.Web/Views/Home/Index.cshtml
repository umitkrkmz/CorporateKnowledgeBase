@model CorporateKnowledgeBase.Application.Features.Dashboard.DashboardDto

@if (!User.Identity!.IsAuthenticated)
{
    <!-- ==================== GUEST LANDING PAGE ==================== -->
    <div class="kb-landing">
        <!-- Hero -->
        <section class="kb-hero">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-7 text-center">
                        <span class="kb-hero-badge">Knowledge Management Platform</span>
                        <h1 class="kb-hero-title">
                            Your Team's<br />
                            <span class="kb-gradient-text">Knowledge Hub</span>
                        </h1>
                        <p class="kb-hero-desc">
                            Centralize documentation, share insights through blog posts, and keep your team aligned with announcements.
                        </p>
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-controller="Account" asp-action="Register" class="kb-btn kb-btn-primary kb-btn-lg">Get Started</a>
                            <a asp-controller="Account" asp-action="Login" class="kb-btn kb-btn-outline kb-btn-lg">Sign In</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features -->
        <section class="kb-features">
            <div class="container">
                <div class="text-center mb-4">
                    <h2 class="kb-section-title">Everything your team needs</h2>
                    <p class="kb-section-subtitle">Built for modern teams that value knowledge sharing</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="kb-feature-card">
                            <div class="kb-feature-icon kb-feature-icon-purple">
                                <svg width="20" height="20" fill="white" viewBox="0 0 16 16">
                                    <path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2m0 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/>
                                    <path d="M4.5 10.5A.5.5 0 0 1 5 10h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 8h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 4h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5"/>
                                </svg>
                            </div>
                            <h5>Technical Docs</h5>
                            <p>Create, version, and organize technical documentation with categories and tags. Export to PDF when needed.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="kb-feature-card">
                            <div class="kb-feature-icon kb-feature-icon-green">
                                <svg width="20" height="20" fill="white" viewBox="0 0 16 16">
                                    <path d="M5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0m4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                                    <path d="m2.165 15.803.02-.004c1.83-.363 2.948-.842 3.468-1.105A9 9 0 0 0 8 15c4.418 0 8-3.134 8-7s-3.582-7-8-7-8 3.134-8 7c0 1.76.743 3.37 1.97 4.6a10.4 10.4 0 0 1-.524 2.318l-.003.011a11 11 0 0 1-.244.637c-.079.186.074.394.273.362a22 22 0 0 0 .693-.125"/>
                                </svg>
                            </div>
                            <h5>Blog &amp; Collaborate</h5>
                            <p>Share knowledge through blog posts, leave comments with threaded replies, and engage with likes.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="kb-feature-card">
                            <div class="kb-feature-icon kb-feature-icon-pink">
                                <svg width="20" height="20" fill="white" viewBox="0 0 16 16">
                                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2M8 1.918l-.797.161A4 4 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4 4 0 0 0-3.203-3.92z"/>
                                </svg>
                            </div>
                            <h5>Real-time Updates</h5>
                            <p>Stay informed with real-time notifications, announcements, and an AI assistant powered by your knowledge base.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats -->
        <section class="kb-stats">
            <div class="container">
                <div class="row text-center g-4">
                    <div class="col-6 col-md-3">
                        <div class="kb-stat">
                            <div class="kb-stat-number" style="color: var(--brand-primary);">@Model.DocumentCount</div>
                            <div class="kb-stat-label">Documents</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kb-stat">
                            <div class="kb-stat-number" style="color: #11998e;">@Model.BlogPostCount</div>
                            <div class="kb-stat-label">Blog Posts</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kb-stat">
                            <div class="kb-stat-number" style="color: #f5576c;">@Model.AnnouncementCount</div>
                            <div class="kb-stat-label">Announcements</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="kb-stat">
                            <div class="kb-stat-number" style="color: #4facfe;">@Model.CategoryCount</div>
                            <div class="kb-stat-label">Categories</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
}
else
{
    <!-- ==================== LOGGED-IN DASHBOARD ==================== -->
    <div class="kb-dashboard">
        <!-- Welcome -->
        <div class="kb-dash-header">
            <div>
                <h2>Welcome back, @User.Identity.Name</h2>
                <p>Here's what's happening in your knowledge base.</p>
            </div>
            <div class="kb-dash-header-actions">
                <a asp-controller="AI" asp-action="Index" class="kb-btn kb-btn-outline kb-btn-sm">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
                    AI Assistant
                </a>
            </div>
        </div>

        <!-- Stats -->
        <div class="row mb-4 g-3">
            <div class="col-6 col-lg-3">
                <a asp-controller="Documents" asp-action="Index" class="kb-dash-stat-card kb-dash-stat-purple">
                    <div class="kb-dash-stat-icon">
                        <svg width="18" height="18" fill="white" viewBox="0 0 16 16"><path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2"/></svg>
                    </div>
                    <div class="kb-dash-stat-content">
                        <div class="kb-dash-stat-value">@Model.DocumentCount</div>
                        <div class="kb-dash-stat-label">Documents</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="BlogPosts" asp-action="Index" class="kb-dash-stat-card kb-dash-stat-green">
                    <div class="kb-dash-stat-icon">
                        <svg width="18" height="18" fill="white" viewBox="0 0 16 16"><path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/></svg>
                    </div>
                    <div class="kb-dash-stat-content">
                        <div class="kb-dash-stat-value">@Model.BlogPostCount</div>
                        <div class="kb-dash-stat-label">Blog Posts</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Announcements" asp-action="Index" class="kb-dash-stat-card kb-dash-stat-pink">
                    <div class="kb-dash-stat-icon">
                        <svg width="18" height="18" fill="white" viewBox="0 0 16 16"><path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2M8 1.918l-.797.161A4 4 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4 4 0 0 0-3.203-3.92z"/></svg>
                    </div>
                    <div class="kb-dash-stat-content">
                        <div class="kb-dash-stat-value">@Model.AnnouncementCount</div>
                        <div class="kb-dash-stat-label">Announcements</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Faq" asp-action="Index" class="kb-dash-stat-card kb-dash-stat-blue">
                    <div class="kb-dash-stat-icon">
                        <svg width="18" height="18" fill="white" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/></svg>
                    </div>
                    <div class="kb-dash-stat-content">
                        <div class="kb-dash-stat-value">@Model.CategoryCount</div>
                        <div class="kb-dash-stat-label">FAQ Categories</div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Announcements -->
        @if (Model.RecentAnnouncements.Any())
        {
            <div class="kb-dash-announce">
                <div class="kb-dash-announce-header">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13 2.5a1.5 1.5 0 0 1 3 0v11a1.5 1.5 0 0 1-3 0zm-1 .724c-2.067.95-4.539 1.481-7 1.656v6.237a25 25 0 0 1 1.088.085c2.053.204 4.038.668 5.912 1.56zm-8 7.841V4.934c-.68.027-1.399.043-2.008.053A2.02 2.02 0 0 0 0 7v2c0 1.106.896 1.996 1.994 2.009l.496.008a64 64 0 0 1 1.51.048m1.39 1.081q.428.032.85.078l.253 1.69a1 1 0 0 1-.983 1.187h-.548a1 1 0 0 1-.916-1.412z"/></svg>
                    Latest Announcements
                </div>
                <div class="kb-dash-announce-list">
                    @foreach (var ann in Model.RecentAnnouncements)
                    {
                        <a asp-controller="Announcements" asp-action="Details" asp-route-id="@ann.Id" class="kb-dash-announce-item">
                            <span class="kb-dash-announce-title">@ann.Title</span>
                            <span class="kb-dash-announce-meta">@ann.AuthorName · @ann.CreatedAt.ToString("dd MMM yyyy")</span>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Content lists -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="kb-dash-section">
                    <div class="kb-dash-section-header">
                        <h6>
                            <svg width="14" height="14" fill="var(--brand-primary)" viewBox="0 0 16 16"><path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2"/></svg>
                            Recent Documents
                        </h6>
                        <a asp-controller="Documents" asp-action="Index">View all →</a>
                    </div>
                    <div class="kb-dash-section-body">
                        @foreach (var doc in Model.RecentDocuments)
                        {
                            <a asp-controller="Documents" asp-action="Details" asp-route-id="@doc.Id" class="kb-dash-list-item">
                                <div class="kb-dash-list-info">
                                    <div class="kb-dash-list-title">@doc.Title</div>
                                    <div class="kb-dash-list-meta">by @doc.AuthorName</div>
                                </div>
                                <span class="kb-dash-list-date">@doc.CreatedAt.ToString("dd MMM")</span>
                            </a>
                        }
                        @if (!Model.RecentDocuments.Any())
                        {
                            <div class="kb-dash-empty">No documents yet.</div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="kb-dash-section">
                    <div class="kb-dash-section-header">
                        <h6>
                            <svg width="14" height="14" fill="#11998e" viewBox="0 0 16 16"><path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/></svg>
                            Recent Blog Posts
                        </h6>
                        <a asp-controller="BlogPosts" asp-action="Index">View all →</a>
                    </div>
                    <div class="kb-dash-section-body">
                        @foreach (var post in Model.RecentBlogPosts)
                        {
                            <a asp-controller="BlogPosts" asp-action="Details" asp-route-id="@post.Id" class="kb-dash-list-item">
                                <div class="kb-dash-list-info">
                                    <div class="kb-dash-list-title">@post.Title</div>
                                    <div class="kb-dash-list-meta">by @post.AuthorName</div>
                                </div>
                                <span class="kb-dash-list-date">@post.CreatedAt.ToString("dd MMM")</span>
                            </a>
                        }
                        @if (!Model.RecentBlogPosts.Any())
                        {
                            <div class="kb-dash-empty">No blog posts yet.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick actions -->
        <div class="kb-dash-actions">
            <span class="kb-dash-actions-label">Quick actions:</span>
            <a asp-controller="Documents" asp-action="Create" class="kb-btn kb-btn-sm kb-dash-action-purple">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                New Document
            </a>
            <a asp-controller="BlogPosts" asp-action="Create" class="kb-btn kb-btn-sm kb-dash-action-green">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                New Blog Post
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Announcements" asp-action="Create" class="kb-btn kb-btn-sm kb-dash-action-pink">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    New Announcement
                </a>
            }
        </div>
    </div>
}
