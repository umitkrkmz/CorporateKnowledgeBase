@model CorporateKnowledgeBase.Application.Features.Faq.FaqDto

<div class="kb-page-header">
    <div>
        <h1 style="display: flex; align-items: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
            Edit FAQ Item
        </h1>
        <p style="color: var(--text-muted); margin: 0;">Update the question and answer details.</p>
    </div>
</div>

<div class="kb-form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="row">
            <div class="col-md-8">
                <div class="kb-form-group">
                    <label class="kb-form-label">Question</label>
                    <input name="Question" class="kb-form-control" value="@Model.Question" required />
                </div>
                <div class="kb-form-group">
                    <label class="kb-form-label">Answer</label>
                    <textarea name="Answer" class="kb-form-control" rows="5" required>@Model.Answer</textarea>
                </div>
            </div>
            <div class="col-md-4">
                <div class="kb-form-group">
                    <label class="kb-form-label">Category</label>
                    <input name="Category" class="kb-form-control" value="@Model.Category" placeholder="e.g. General, Technical, Account" />
                </div>
                <div class="kb-form-group">
                    <label class="kb-form-label">Sort Order</label>
                    <input name="SortOrder" class="kb-form-control" type="number" value="@Model.SortOrder" />
                </div>
                <div class="kb-form-group">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input name="IsPublished" type="checkbox" class="form-check-input" value="true"
                               @(Model.IsPublished ? "checked" : "") />
                        <span class="kb-form-label" style="margin: 0;">Published</span>
                    </label>
                </div>
            </div>
        </div>
        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
            <button type="submit" class="kb-btn kb-btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Save
            </button>
            <a asp-action="Index" class="kb-btn kb-btn-outline">Cancel</a>
        </div>
    </form>
</div>
