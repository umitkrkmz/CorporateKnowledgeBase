@model List<CorporateKnowledgeBase.Application.Features.Faq.FaqDto>

<div class="kb-admin-page">
    <div class="kb-page-header">
        <div>
            <h2>Frequently Asked Questions</h2>
            <p style="color: var(--text-muted); margin: 0;">Find answers to common questions.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="kb-btn kb-btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.35rem;"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
                New FAQ
            </a>
        }
    </div>

    @if (TempData["Success"] is string msg)
    {
        <div class="kb-alert kb-alert-success" style="display: flex; align-items: center; justify-content: space-between;">
            <span>@msg</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" style="font-size: 0.75rem;"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="kb-empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.4;"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            <p style="color: var(--text-muted); margin-top: 1rem;">No FAQ items yet.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="kb-btn kb-btn-primary" style="margin-top: 1rem;">Create First FAQ</a>
            }
        </div>
    }
    else
    {
        <!-- Search Box -->
        <div class="kb-table-toolbar" style="margin-bottom: 1.5rem;">
            <div class="kb-toolbar-search" style="flex: 1; max-width: 500px;">
                <div class="kb-search-input-wrapper" style="flex: 1; max-width: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="faqSearch" class="kb-search-input" placeholder="Search FAQs..." />
                </div>
            </div>
            <div class="kb-toolbar-right">
                <span class="kb-badge kb-badge-muted" id="faqCount">@Model.Count FAQs</span>
                <button type="button" class="kb-btn kb-btn-outline kb-btn-sm" id="expandAllBtn">Expand All</button>
                <button type="button" class="kb-btn kb-btn-outline kb-btn-sm" id="collapseAllBtn" style="display: none;">Collapse All</button>
            </div>
        </div>

        <!-- No Results Message -->
        <div id="noResults" class="kb-empty-state" style="display: none;">
            <p style="color: var(--text-muted);">No FAQs match your search.</p>
            <button type="button" class="kb-btn kb-btn-outline" onclick="document.getElementById('faqSearch').value=''; filterFaqs();">Clear Search</button>
        </div>

        <!-- FAQ Categories -->
        <div id="faqContainer">
            @{
                var grouped = Model.GroupBy(f => f.Category ?? "General").OrderBy(g => g.Key);
            }
            @foreach (var group in grouped)
            {
                <div class="faq-category" data-category="@group.Key" style="margin-bottom: 2rem;">
                    <h4 style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-dark); margin-bottom: 1rem; font-weight: 600;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        @group.Key
                        <span class="kb-badge kb-badge-muted category-count">@group.Count()</span>
                    </h4>
                    <div class="accordion" id="faq-@group.Key.Replace(" ", "-").Replace(".", "")">
                        @foreach (var faq in group.OrderBy(f => f.SortOrder))
                        {
                            var collapseId = $"faq-collapse-{faq.Id}";
                            var headerId = $"faq-header-{faq.Id}";
                            <div class="accordion-item faq-item" data-question="@faq.Question.ToLower()" data-answer="@faq.Answer.ToLower()" data-category="@group.Key.ToLower()">
                                <h2 class="accordion-header" id="@headerId">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                        @faq.Question
                                        @if (!faq.IsPublished)
                                        {
                                            <span class="kb-badge kb-badge-warning" style="margin-left: 0.5rem;">Draft</span>
                                        }
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#faq-@group.Key.Replace(" ", "-").Replace(".", "")">
                                    <div class="accordion-body">
                                        <div style="color: var(--text-body); line-height: 1.7;">
                                            @Html.Raw(faq.Answer)
                                        </div>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-color); display: flex; gap: 0.5rem;">
                                                <a asp-action="Edit" asp-route-id="@faq.Id" class="kb-btn kb-btn-outline kb-btn-sm">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                                    Edit
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@faq.Id" method="post" style="display: inline;"
                                                      onsubmit="return confirm('Delete this FAQ item?');">
                                                    <button type="submit" class="kb-btn kb-btn-danger kb-btn-sm">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.25rem;"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('faqSearch');
        const expandAllBtn = document.getElementById('expandAllBtn');
        const collapseAllBtn = document.getElementById('collapseAllBtn');

        if (searchInput) {
            searchInput.addEventListener('input', filterFaqs);
        }

        if (expandAllBtn) {
            expandAllBtn.addEventListener('click', function() {
                document.querySelectorAll('.accordion-collapse').forEach(el => {
                    new bootstrap.Collapse(el, { toggle: false }).show();
                });
                expandAllBtn.style.display = 'none';
                collapseAllBtn.style.display = 'inline-flex';
            });
        }

        if (collapseAllBtn) {
            collapseAllBtn.addEventListener('click', function() {
                document.querySelectorAll('.accordion-collapse').forEach(el => {
                    new bootstrap.Collapse(el, { toggle: false }).hide();
                });
                collapseAllBtn.style.display = 'none';
                expandAllBtn.style.display = 'inline-flex';
            });
        }
    });

    function filterFaqs() {
        const searchTerm = document.getElementById('faqSearch').value.toLowerCase().trim();
        const faqItems = document.querySelectorAll('.faq-item');
        const categories = document.querySelectorAll('.faq-category');
        const noResults = document.getElementById('noResults');
        const faqContainer = document.getElementById('faqContainer');
        let visibleCount = 0;

        // Filter individual FAQ items
        faqItems.forEach(item => {
            const question = item.dataset.question || '';
            const answer = item.dataset.answer || '';
            const category = item.dataset.category || '';

            const matches = searchTerm === '' ||
                question.includes(searchTerm) ||
                answer.includes(searchTerm) ||
                category.includes(searchTerm);

            item.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;

            // Expand matching items when searching
            if (matches && searchTerm !== '') {
                const collapseEl = item.querySelector('.accordion-collapse');
                if (collapseEl && !collapseEl.classList.contains('show')) {
                    new bootstrap.Collapse(collapseEl, { toggle: false }).show();
                }
            }
        });

        // Hide empty categories
        categories.forEach(category => {
            const visibleItems = category.querySelectorAll('.faq-item[style=""], .faq-item:not([style*="display: none"])');
            const hasVisibleItems = Array.from(category.querySelectorAll('.faq-item')).some(item => item.style.display !== 'none');
            category.style.display = hasVisibleItems ? '' : 'none';

            // Update category count
            const countBadge = category.querySelector('.category-count');
            if (countBadge) {
                const count = Array.from(category.querySelectorAll('.faq-item')).filter(item => item.style.display !== 'none').length;
                countBadge.textContent = count;
            }
        });

        // Update total count
        const faqCount = document.getElementById('faqCount');
        if (faqCount) {
            faqCount.textContent = visibleCount + ' FAQ' + (visibleCount !== 1 ? 's' : '');
        }

        // Show/hide no results message
        if (noResults && faqContainer) {
            noResults.style.display = visibleCount === 0 ? '' : 'none';
            faqContainer.style.display = visibleCount === 0 ? 'none' : '';
        }
    }
</script>
}
