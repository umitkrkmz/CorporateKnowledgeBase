@model List<CorporateKnowledgeBase.Application.Features.Notifications.NotificationItemDto>
@using CorporateKnowledgeBase.Domain.Enums

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="kb-page-header">
    <div>
        <h1 style="display: flex; align-items: center; gap: 0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            Notifications
        </h1>
        <p style="color: var(--text-muted); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            @if (unreadCount > 0)
            {
                <span class="kb-badge kb-badge-primary">@unreadCount unread</span>
            }
            @Model.Count total notifications
        </p>
    </div>
    @if (unreadCount > 0)
    {
        <button class="kb-btn kb-btn-outline kb-btn-sm" onclick="markAllAndReload()" style="display: inline-flex; align-items: center; gap: 0.4rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Mark all as read
        </button>
    }
</div>

@if (Model.Count == 0)
{
    <div class="kb-empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.4;"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        <p style="color: var(--text-muted); margin-top: 1rem;">No notifications yet.</p>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        @foreach (var n in Model)
        {
            var iconSvg = n.ContentType switch
            {
                ContentType.Document => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>",
                ContentType.BlogPost => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg>",
                ContentType.Announcement => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 11 18-5v12L3 13v-2z\"/><path d=\"M11.6 16.8a3 3 0 1 1-5.8-1.6\"/></svg>",
                _ => "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/></svg>"
            };

            var typeLabel = n.ContentType switch
            {
                ContentType.Document => "Document",
                ContentType.BlogPost => "Blog Post",
                ContentType.Announcement => "Announcement",
                _ => ""
            };

            var hasLink = n.ReferenceId.HasValue;

            <a href="@(hasLink ? Url.Action("GoTo", "Notifications", new { id = n.Id }) : "#")"
               class="kb-card @(!hasLink ? "pe-none" : "")"
               style="display: block; text-decoration: none; transition: var(--transition); @(!n.IsRead ? "border-left: 3px solid var(--brand-primary);" : "")">
                <div class="kb-card-body" style="padding: 1rem 1.25rem;">
                    <div style="display: flex; align-items: flex-start; gap: 0.875rem;">
                        <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: var(--radius-md); background: var(--bg-surface); display: flex; align-items: center; justify-content: center; color: @(!n.IsRead ? "var(--brand-primary)" : "var(--text-muted)");">
                            @Html.Raw(iconSvg)
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                                <span style="color: var(--text-dark); @(!n.IsRead ? "font-weight: 600;" : "font-weight: 400;")">@n.Message</span>
                                <span style="color: var(--text-muted); font-size: 0.8rem; white-space: nowrap; flex-shrink: 0;">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div style="margin-top: 0.4rem; display: flex; gap: 0.4rem;">
                                <span class="kb-badge kb-badge-muted">@typeLabel</span>
                                @if (!n.IsRead)
                                {
                                    <span class="kb-badge kb-badge-primary">New</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
}

@section Scripts {
<script>
    async function markAllAndReload() {
        await fetch('/Notifications/MarkAllRead', { method: 'POST' });
        location.reload();
    }
</script>
}
